#!/usr/bin/env bash
set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../scripts" && pwd)"

usage() {
  cat >&2 <<'USAGE'
usage: kitty-agents <command>

  watch            save the open sessions and shells whenever they change
  save             save the open sessions and shells
  restore          reopen what the last snapshot holds
USAGE
  exit 1
}

case "${1:-}" in
  watch) exec "$SCRIPTS_DIR/watch.sh" ;;
  save) exec "$SCRIPTS_DIR/save.sh" manual ;;
  restore) exec "$SCRIPTS_DIR/restore.sh" ;;
  *) usage ;;
esac
