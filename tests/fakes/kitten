#!/usr/bin/env bash
shift
command="$1"
shift
printf '%s\n' "$command $*" >> "$KITTEN_FAKE_LOG"
case "$command" in
  ls)
    [ -f "$KITTEN_FAKE_LS" ] || exit 1
    if [ -f "$KITTEN_FAKE_LS.queue" ]; then
      KITTEN_FAKE_LS_NEXT="$(cat "$KITTEN_FAKE_LS.queue")"
    fi
    cat "$KITTEN_FAKE_LS"
    if [ -n "${KITTEN_FAKE_LS_NEXT:-}" ]; then
      next="${KITTEN_FAKE_LS_NEXT%%:*}"
      rest="${KITTEN_FAKE_LS_NEXT#"$next"}"
      cp "$next" "$KITTEN_FAKE_LS"
      printf '%s' "${rest#:}" > "$KITTEN_FAKE_LS.queue"
    fi
    ;;
  set-tab-title) ;;
  launch) echo "${KITTEN_FAKE_LAUNCH_ID:-100}" ;;
  send-text) ;;
  close-tab) ;;
  *) exit 1 ;;
esac
