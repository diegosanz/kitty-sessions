#!/usr/bin/env bash
shift
command="$1"
shift
printf '%s\n' "$command $*" >> "$KITTEN_FAKE_LOG"
case "$command" in
  ls)
    [ -f "$KITTEN_FAKE_LS" ] || exit 1
    cat "$KITTEN_FAKE_LS"
    if [ -n "${KITTEN_FAKE_LS_NEXT:-}" ]; then
      cp "$KITTEN_FAKE_LS_NEXT" "$KITTEN_FAKE_LS"
    fi
    ;;
  launch) echo "${KITTEN_FAKE_LAUNCH_ID:-100}" ;;
  send-text) ;;
  *) exit 1 ;;
esac
